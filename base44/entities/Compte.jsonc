      "type": "string",
      "description": "Mois de vote du budget (collectivit\u00e9s)"
    },
    "date_dernier_contact": {
      "type": "string",
      "format": "date"
    },
    "prochaine_action_date": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags multiples (Bio, Insertion, March\u00e9 public, Z\u00e9ro phyto\u2026)"
    },
    "consentement_rgpd": {
      "type": "string",
      "enum": [
