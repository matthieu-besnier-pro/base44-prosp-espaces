      "type": "string",
      "description": "Synth\u00e8se IA \u00e0 jour du compte"
    },
    "angle_approche_ia": {
      "type": "string"
    },
    "signaux_ia": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Signaux dat\u00e9s (appel d'offres, actualit\u00e9, budget vot\u00e9\u2026)"
    },
    "date_maj_ia": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "raison_sociale"
  ],
  "name": "Compte",
  "type": "object"
